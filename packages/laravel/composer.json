{
  "name": "likha/laravel",
  "description": "Laravel Blade integration for Likha Editor",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Shiv Singh",
      "email": "shiv@srapsware.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0"

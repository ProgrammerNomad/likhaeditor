{
  "name": "@likhaeditor/ui",
  "version": "0.0.2",
  "description": "UI components for Likha editor",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && node -e \"require('fs').copyFileSync('src/editor.css', 'dist/style.css')\"",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "editor",
    "ui",
    "toolbar",
    "components"
  ],
  "author": "Shiv Singh <shiv@srapsware.com> (https://github.com/ProgrammerNomad)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProgrammerNomad/likhaeditor.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/ProgrammerNomad/likhaeditor#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@likhaeditor/core": "workspace:^",
    "lucide": "^0.294.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}

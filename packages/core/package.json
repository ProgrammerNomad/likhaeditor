{
  "name": "@likhaeditor/core",
  "version": "0.0.3",
  "description": "Core editor engine for Likha - framework-agnostic",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && node ../../scripts/finalize-declarations.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "editor",
    "rich-text",
    "prosemirror",
    "wysiwyg"
  ],
  "author": "Shiv Singh <shiv@srapsware.com> (https://github.com/ProgrammerNomad)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProgrammerNomad/likhaeditor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ProgrammerNomad/likhaeditor#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}

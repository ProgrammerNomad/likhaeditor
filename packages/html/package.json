{
  "name": "@likhaeditor/likhaeditor",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/likha-editor.css",
    "./dist/likha-editor.css": "./dist/likha-editor.css"
  },
  "files": [
    "dist"
  ],
  "description": "Vanilla JavaScript wrapper for Likha editor - works without build tools",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "html",
    "javascript",
    "vanilla-js"
  ],
  "author": "Shiv Singh <shiv@srapsware.com> (https://github.com/ProgrammerNomad)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProgrammerNomad/likhaeditor.git",
    "directory": "packages/html"
  },
  "homepage": "https://github.com/ProgrammerNomad/likhaeditor#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('src/likha-editor.css', 'dist/likha-editor.css')\" && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@likhaeditor/core": "workspace:^",
    "@likhaeditor/plugins": "workspace:^",
    "@likhaeditor/ui": "workspace:^",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}

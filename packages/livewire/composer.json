{
  "name": "likha/livewire",
  "description": "Livewire component for Likha Editor",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Shiv Singh",
      "email": "shiv@srapsware.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "livewire/livewire": "^3.0",
    "likha/laravel": "*@dev"
